# Telegram Bot Token (obtained from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq API Key (obtained from groq console)
GROQ_API_KEY=your_groq_api_key_here

# CockroachDB / PostgreSQL Connection String URL
COCKROACH_DB_URL=postgresql://root@localhost:26257/defaultdb?sslmode=disable

# Run mode: set to true to use Long Polling (ideal for local testing)
USE_LONG_POLLING=true
